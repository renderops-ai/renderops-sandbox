# syntax=docker/dockerfile:1
#
# Dockerfile.rootfs — self-contained build of the RenderOps VM assets. Everything
# comes from THIS repo (guest-agent/) plus Alpine packages and the Go toolchain;
# there is no dependency on any external asset tree. Built via `make assets`,
# which uses BuildKit `--output` to emit the artifacts straight to the host:
#
#   docker build --target rootfs-export    -o type=local,dest=assets/rootfs .  → rootfs-alpine.ext4
#   docker build --target initramfs-export -o type=local,dest=assets .         → initramfs.cpio.gz
#
ARG ALPINE=alpine:3.20

# OpenVSCode is pinned and checksum-verified so rebuilding a rootfs cannot
# silently install a different editor release. The worker gateway provides
# authentication; OpenVSCode itself remains reachable only inside the microVM.
FROM ${ALPINE} AS openvscode
ARG TARGETARCH
ARG OPENVSCODE_VERSION=1.109.5
ARG OPENVSCODE_SHA256_AMD64=b433bf4f0227321a7014d8460d10a8f958adc0f45aa79bd889e84e65e8f88363
ARG OPENVSCODE_SHA256_ARM64=36d9c14036489b63de84ebace837fcacf7e60e669a0dc715802c5443684ea4dc
RUN apk add --no-cache ca-certificates curl tar \
 && case "${TARGETARCH}" in \
      amd64) release_arch=x64; expected="${OPENVSCODE_SHA256_AMD64}" ;; \
      arm64) release_arch=arm64; expected="${OPENVSCODE_SHA256_ARM64}" ;; \
      *) echo "unsupported OpenVSCode architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && archive="openvscode-server-v${OPENVSCODE_VERSION}-linux-${release_arch}.tar.gz" \
 && curl --fail --location --retry 3 --output "/tmp/${archive}" \
      "https://github.com/gitpod-io/openvscode-server/releases/download/openvscode-server-v${OPENVSCODE_VERSION}/${archive}" \
 && echo "${expected}  /tmp/${archive}" | sha256sum -c - \
 && mkdir -p /opt/openvscode-server \
 && tar -xzf "/tmp/${archive}" --strip-components=1 -C /opt/openvscode-server \
 && rm -f "/tmp/${archive}"

# ── guest-agent: built from this repo's source, no host Go needed ────────────
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS guestbuild
ARG TARGETARCH
WORKDIR /src
COPY guest-agent/go.mod guest-agent/go.sum ./
RUN go mod download
COPY guest-agent/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -o /guest-agent .

# ── rootfs contents: Alpine + python/node + jupyter stack + guest-agent ──────
FROM ${ALPINE} AS rootfs
RUN apk add --no-cache \
    bash busybox iproute2 util-linux ca-certificates curl git openssh-client \
    gcompat libstdc++ \
    python3 py3-pip nodejs npm
# Verify development tools at image build time, before templates are published.
# Every sandbox inherits these files; there is no install step during VM boot.
RUN git --version && test -s /etc/ssl/certs/ca-certificates.crt
# Python kernel stack for stateful execution (kernel_bridge.py).
RUN pip install --no-cache-dir --break-system-packages \
    ipykernel==7.2.0 ipython==9.12.0 jupyter_client==8.8.0 jupyter_core==5.9.1 \
    pyzmq==27.1.0 debugpy==1.8.20 psutil==7.2.2
# Bridges + the guest-agent binary from this repo.
COPY guest-agent/kernel_bridge.py /usr/local/bin/kernel_bridge.py
COPY guest-agent/node_bridge.js   /usr/local/bin/node_bridge.js
COPY --from=guestbuild /guest-agent /usr/local/bin/guest-agent
COPY --from=openvscode /opt/openvscode-server /opt/openvscode-server
RUN rm /opt/openvscode-server/node \
 && ln -s /usr/bin/node /opt/openvscode-server/node \
 && chmod +x /usr/local/bin/guest-agent /usr/local/bin/kernel_bridge.py
RUN /opt/openvscode-server/bin/openvscode-server --version
# Guest identity + policy baked in (no per-VM runtime rootfs mount):
#   - never prompt for git credentials inside a VM
#   - pip installs into the system env (ephemeral single-use VMs) — dodge PEP 668
#   - DNS so hostnames resolve without relying on network config flow
#   - fixed network identity: every slot reuses TAP 172.16.0.1, guest 172.16.0.2
ENV GIT_TERMINAL_PROMPT=0
RUN git config --global credential.helper "" \
 && printf '[global]\nbreak-system-packages = true\n' > /etc/pip.conf \
 && printf 'GUESTIP=172.16.0.2\nGWIP=172.16.0.1\n' > /etc/vm-network.env \
 && mkdir -p /workspace

# ── pack the rootfs into an ext4 image (mkfs -d, no mount / no privileges) ───
FROM ${ALPINE} AS ext4build
ARG ROOTFS_SIZE=2G
RUN apk add --no-cache e2fsprogs
COPY --from=rootfs / /rootfs-root
# Drop pseudo-fs mountpoints so mke2fs doesn't choke on device nodes; the guest
# init mounts proc/sys/devtmpfs itself. -d populates the fs from a directory
# without mounting it, so this works in an unprivileged build.
RUN rm -rf /rootfs-root/proc /rootfs-root/sys && mkdir -p /rootfs-root/proc /rootfs-root/sys \
 && rm -rf /rootfs-root/dev && mkdir -p /rootfs-root/dev \
 && printf 'nameserver 8.8.8.8\n' > /rootfs-root/etc/resolv.conf \
 && mkdir -p /out \
 && mkfs.ext4 -q -L rootfs -m 0 -d /rootfs-root /out/rootfs-alpine.ext4 ${ROOTFS_SIZE}

FROM scratch AS rootfs-export
COPY --from=ext4build /out/rootfs-alpine.ext4 /

# ── initramfs: static busybox + this repo's OverlayFS init ───────────────────
FROM ${ALPINE} AS initramfsbuild
RUN apk add --no-cache busybox-static cpio gzip
WORKDIR /irfs
RUN mkdir -p bin proc sys dev lower upper merged \
 && cp /bin/busybox.static bin/busybox \
 && for a in sh mount mkdir sleep switch_root; do ln -s busybox bin/$a; done
COPY guest-agent/initramfs/init /irfs/init
RUN chmod +x /irfs/init \
 && mkdir -p /out \
 && (cd /irfs && find . | cpio -o -H newc | gzip -9 > /out/initramfs.cpio.gz)

FROM scratch AS initramfs-export
COPY --from=initramfsbuild /out/initramfs.cpio.gz /
