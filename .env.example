# Copy to .env in this directory. start.sh sources it before starting the
# control plane; docker-compose reads it as env_file.

# Postgres — the same DB the SvelteKit app owns (schema via its drizzle
# migrations). Auth (better-auth sessions + API keys) resolves against it too.
DATABASE_URL="postgres://user:password@host:5432/renderops"

PORT="8080"
LOG_LEVEL="info"    # info | debug
LOG_FORMAT="json"   # json | text

# ── Worker plane (reached over SSH; see plan.md) ─────────────────────────────
# SSH_COMMAND is how the control plane reaches the KVM host — host/user/key
# live in ~/.ssh/config under this alias. ROOT_DIRECTORY is the base dir ON
# THAT HOST: everything we push or create remotely (agent binary, assets,
# sockets, snapshots) lives under it. `~` expands on the remote side.
SSH_COMMAND="ssh ro"
ROOT_DIRECTORY="~/aman/"

# Shared secret the control plane presents to the agent (X-Worker-Token). Must
# match what the agent was started with (deploy/agent-run.sh WORKER_TOKEN).
WORKER_TOKEN="devtoken123"
# Local port the control plane forwards to the agent's 127.0.0.1:9876 over SSH.
AGENT_LOCAL_PORT="19876"

# Output collector: worker only, enable after guest/rootfs + DB upgrade.
# Use the actual private control-plane URL or an SSH-forwarded port.
WORKER_LOG_INGEST_URL="http://127.0.0.1:18081/internal/logs/batches"
WORKER_LOG_SPOOL_DIR="/opt/renderops/worker/logs/pending"
