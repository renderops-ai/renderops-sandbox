# Created as /opt/renderops-orchestrator/.env by setup.sh.
# Never commit the populated file.

# CI replaces this with the immutable SHA tag it deploys. Persisting the tag
# makes later health checks and manual Compose restarts use the same image.
ORCHESTRATOR_IMAGE=

# Must be a database endpoint reachable privately from this server. The current
# control-plane-only Docker hostname "postgres" will not resolve here.
DATABASE_URL=

# Bind only to this server's private network interface, never 0.0.0.0.
ORCHESTRATOR_BIND_IP=

# Shared only with control-plane and worker services. Use a random secret.
ORCHESTRATOR_TOKEN=

# Shared with workers; the orchestrator presents it on lifecycle requests.
WORKER_TOKEN=

ORCHESTRATOR_HEARTBEAT_TTL_SECONDS=30

# Placement policy. Workers advertise physical capacity; these ratios control
# only how much capacity the orchestrator may reserve.
ORCHESTRATOR_CPU_OVERCOMMIT_RATIO=2
ORCHESTRATOR_MEMORY_OVERCOMMIT_RATIO=1
