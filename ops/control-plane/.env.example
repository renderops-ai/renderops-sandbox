# Created as /opt/renderops/.env by setup.sh. Fill in real values before the
# first Compose deployment.
# docker compose reads this automatically. Never commit the real .env.

# --- database (dev: local postgres container; prod: managed DB) ---
POSTGRES_PASSWORD=

# --- control plane -> orchestrator and selected workers ---
ORCHESTRATOR_URL=http://10.0.0.7:8090
ORCHESTRATOR_TOKEN=
WORKER_TOKEN=
TERMINAL_ALLOWED_ORIGINS=dev.renderops.com
PREVIEW_DOMAIN=dev-sandbox.renderops.com

# Restricted Cloudflare token: Zone/DNS Edit + Zone/Zone Read for renderops.com.
CLOUDFLARE_API_TOKEN=

# Encrypts model provider credentials saved on the dashboard's Secrets page;
# the control plane and the platform both need it. `openssl rand -base64 32`.
# Changing it makes saved credentials unreadable (users re-enter them).
SECRETS_ENCRYPTION_KEY=

# --- agent sessions (off by default) ---
# The platform queues sessions (AGENT_SESSIONS_ENABLED=true); the control
# plane's runner claims and runs them (AGENT_RUNNER_ENABLED=true). Both use
# AGENT_WORKER_TOKEN (at least 32 characters, `openssl rand -hex 32`) and need
# SECRETS_ENCRYPTION_KEY. Leave the rest empty for the defaults.
AGENT_SESSIONS_ENABLED=
AGENT_RUNNER_ENABLED=
AGENT_WORKER_TOKEN=
# PLATFORM_INTERNAL_URL=http://platform:3000
# AGENT_RUNNER_CONCURRENCY=4
# AGENT_TURN_TIMEOUT=45m

# --- platform (SvelteKit / Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://dev.renderops.com
BETTER_AUTH_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
